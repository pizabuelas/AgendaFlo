# =============================================================================
# AgendaFlow — Variables de entorno
# Copia este archivo a `.env` y completa los valores:
#   cp .env.example .env      (Windows: copy .env.example .env)
# =============================================================================

# -----------------------------------------------------------------------------
# BASE DE DATOS
# -----------------------------------------------------------------------------
# Proveedor usado por Prisma. Valores admitidos: "postgresql" | "sqlite"
#
#  · "postgresql" → producción (Vercel, Railway, Neon, Supabase...)
#  · "sqlite"     → desarrollo local sin instalar nada (archivo prisma/dev.db)
#
# Si usas Vercel + Postgres define esta variable en el panel del proyecto.
DATABASE_PROVIDER="sqlite"

# Desarrollo local con SQLite (ruta relativa a la carpeta prisma/)
DATABASE_URL="file:./dev.db"

# Producción con PostgreSQL — sustituye por la URL de tu proveedor.
# Ejemplo Neon:  postgresql://usuario:clave@ep-xxx.sa-east-1.aws.neon.tech/agendaflow?sslmode=require
# Ejemplo Railway: postgresql://usuario:clave@host.railway.app:5432/agendaflow?sslmode=require
# DATABASE_URL="postgresql://usuario:clave@localhost:5432/agendaflow?schema=public"

# -----------------------------------------------------------------------------
# AUTENTICACIÓN (RF-01)
# -----------------------------------------------------------------------------
# Clave secreta para firmar los JWT de sesión. Mínimo 32 caracteres.
# Genera una con:  openssl rand -base64 48
AUTH_SECRET="cambia-esta-clave-por-una-aleatoria-de-al-menos-32-caracteres"

# Vida de la sesión en segundos (por defecto 7 días)
AUTH_SESSION_TTL="604800"

# -----------------------------------------------------------------------------
# APLICACIÓN
# -----------------------------------------------------------------------------
# URL pública del sitio (Vercel la inyecta automáticamente)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Nombre visible de la aplicación
NEXT_PUBLIC_APP_NAME="AgendaFlow"

# -----------------------------------------------------------------------------
# CORREO (opcional — las notificaciones se registran en la base de datos)
# -----------------------------------------------------------------------------
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
