{
  "name": "agendaflow",
  "version": "1.0.0",
  "private": true,
  "description": "AgendaFlow — Sistema web de gestión de citas y reservas",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prisma-generate.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/prisma-generate.mjs",
    "db:generate": "node scripts/prisma-generate.mjs",
    "db:push": "node scripts/generate-sqlite-schema.mjs && node scripts/prisma-cli.mjs push && node scripts/crear-indices.mjs",
    "db:seed": "node scripts/prisma-seed.mjs",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:studio": "node scripts/prisma-cli.mjs studio",
    "db:reset": "node scripts/prisma-cli.mjs reset && node scripts/crear-indices.mjs",
    "setup": "npm run db:push && npm run db:seed",
    "capturas": "node --expose-gc scripts/capturas.mjs",
    "verificar": "node scripts/verificar.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.2",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "jose": "6.1.0",
    "lucide-react": "0.545.0",
    "next": "15.5.28",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "3.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "20.19.1",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "eslint": "9.39.0",
    "eslint-config-next": "15.5.28",
    "prisma": "6.19.3",
    "tailwindcss": "4.1.14",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
